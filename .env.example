# Conexão com o Supabase — copie para .env.local e preencha com os dados do seu projeto.
# (Supabase → Project Settings → Data API / API Keys)
#
# Este projeto é Vite, então o prefixo padrão é VITE_.
# Os nomes com NEXT_PUBLIC_ também funcionam, para combinar com o painel da Vercel.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Alternativa aceita (mesmo efeito):
# NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# NUNCA coloque aqui a chave de serviço (service_role). Ela dá acesso total ao
# banco e a loja não precisa dela — quem escreve é o painel, com login.
