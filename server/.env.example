# ============================================================
#  Beauty and self — configuração do servidor
#  Copie para server/.env (local) ou cole estas variáveis no
#  EasyPanel (aba "Environment"). NUNCA publique a chave real.
# ============================================================

# --- IA de imagem (obrigatório para gerar imagens) -----------
# Crie em https://fal.ai → Settings → API Keys
FAL_KEY=
# Modelo usado (por enquanto: muse = Meta Muse Image)
AI_MODEL=muse

# --- Login com Google (obrigatório para o login) -------------
# "ID do cliente OAuth" do tipo "Aplicativo da Web" (gratuito).
# Veja o passo a passo no README.
GOOGLE_CLIENT_ID=

# Segredo para assinar a sessão (qualquer texto longo e aleatório).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Quem pode entrar (opcional). Vazio = qualquer conta Google.
# Ex.: ana@gmail.com,joao@gmail.com,@meusalao.com.br
ALLOWED_EMAILS=

# Botão "Entrar em modo de teste" sem Google (true/false).
# Use só para testar — deixe false em produção.
DEMO_LOGIN=false

# --- Limites de uso por conta (protege seus créditos) --------
LIMIT_PER_HOUR=60
LIMIT_PER_DAY=400

# --- Servidor -------------------------------------------------
PORT=8787
