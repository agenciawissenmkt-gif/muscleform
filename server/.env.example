# ============================================================
#  Beauty and self — configuração do servidor
#  Copie para server/.env (local) ou cole estas variáveis na
#  Vercel / EasyPanel. NUNCA publique as chaves reais.
# ============================================================

# --- Qual site é este -----------------------------------------
# app = aplicativo dos salões · panel = painel empresarial · both = os dois (local)
APP_ROLE=both
# O mesmo valor, para o navegador (lido na hora de compilar)
VITE_APP_ROLE=both
# Endereço do painel (no site do app) e do app (no site do painel)
VITE_PANEL_URL=
VITE_APP_URL=

# --- IA de imagem (obrigatório no app) ------------------------
# Crie em https://fal.ai → Settings → API Keys
FAL_KEY=
# Modelo usado (por enquanto: muse = Meta Muse Image)
AI_MODEL=muse

# --- Banco de dados + login com Google (Supabase) --------------
# Projeto "beauty-and-self" no Supabase. A chave é a "publishable" (pública).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Senha interna entre o servidor e o banco (o banco guarda só o hash dela).
# Tem que ser a MESMA no app e no painel.
BS_SECRET=

# Segredo para assinar a sessão (qualquer texto longo e aleatório).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Servidor -------------------------------------------------
PORT=8787
